<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only (doc 17.1). Certificate pinning is done in Dart
     (CERT_PINS, at least two pins), so it also covers the FCM receipt call. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
